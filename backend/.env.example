DATABASE_URL=sqlite:aggregated_plan.db?mode=rwc
RUST_LOG=info

# Jira connector (configured via Settings page)
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=your@email.com
# JIRA_API_TOKEN=your-api-token

# Outlook OAuth (authorization-code flow; the access token is obtained via the
# "Connect Outlook" button in Settings and refreshed automatically — no manual paste)
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3001/auth/outlook/callback
