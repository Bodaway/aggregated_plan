DATABASE_URL=sqlite:aggregated_plan.db?mode=rwc
RUST_LOG=info

# Jira connector (configured via Settings page)
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=your@email.com
# JIRA_API_TOKEN=your-api-token

# Microsoft sign-in (authorization-code flow; one Graph token powers Outlook + Excel/SharePoint).
# The app is gated by a Microsoft sign-in at startup; tokens are obtained and refreshed automatically.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback
